# Copy to .env.local and fill in. Every value here is server-only:
# none of them may be prefixed with NEXT_PUBLIC_.

# --- Model (any OpenAI-compatible endpoint; NVIDIA NIM by default) ---
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
# Optional overrides (defaults shown)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Supabase ---
# Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
# The *secret* key (sb_secret_...) or the legacy service_role key.
# It bypasses Row Level Security, so it must never reach the browser.
SUPABASE_SECRET_KEY=sb_secret_...
